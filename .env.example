# Supabase (public + server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini (server-only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Upstash Redis (server-only, optional): multi-instance rate limits.
# Without these, the API fails open to in-memory limits (single-instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# App URL:
# - локально в .env.local оставь http://localhost:3000
# - в Vercel Production выставь https://lingua-ai-project.vercel.app
# Код сам подставит VERCEL_URL / request origin как запасной вариант.
NEXT_PUBLIC_APP_URL=http://localhost:3000
